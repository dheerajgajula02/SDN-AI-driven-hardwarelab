# Lab 9 Part B: LLM settings. Copy to .env (never committed) and fill in.
# Change any of these whenever you like; no code change needed.
LAB9_LLM_API_KEY=
LAB9_LLM_MODEL=deepseek-v4.1-flash
LAB9_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Optional: max model calls per run (default 60)
# LAB9_LLM_MAX_CALLS=60
# Optional: model reasoning: off | low | medium | high | default.
# "off" was chosen by the B1 experiment (logs/stepB1_analyst/experiment_run2.txt).
LAB9_LLM_REASONING=off
