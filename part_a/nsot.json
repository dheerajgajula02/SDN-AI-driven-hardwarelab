{
  "_about": "Lab 9 network source of truth. Read by the controller app, nsot_apply.py and the Mininet script. Port keys are OpenFlow port numbers. No secrets in this file.",

  "controller": {
    "ip": "10.224.78.132",
    "openflow_port": 6633,
    "rest_port": 8080
  },

  "management": {
    "mode": "out-of-band",
    "subnet": "10.224.0.0/16",
    "isolated_from_vlans": [10, 20],
    "allowed_protocols": ["openflow", "ssh", "rest"],
    "physical_porting_note": "On lab day, replace subnet and each device mgmt.ip with the rack management VLAN/subnet (e.g. Management1 on Arista, OOBM/mgmt VLAN on HP, mgmt NIC on OVS servers)."
  },

  "dns_blacklist": {
    "enabled": true,
    "verdict_url": "http://127.0.0.1:8053/check",
    "verdict_service_port": 8053,
    "blocked_page_ip": "10.10.20.21",
    "priority": 50,
    "cookie": 48,
    "test_domains": {
      "good": "good.lab9.lan",
      "bad": "bad.lab9.lan"
    }
  },

  "protected_flows": {
    "_about": "Traffic the AI layer must never disrupt (Integration Rules). part_b/nsot_validator.py builds real example packets from these entries for every host and refuses any AI rule that would match one of them without a higher-priority protected rule catching it first.",
    "dns_intercept":  {"priority": 50, "cookie": 48, "match": {"eth_type": 2048, "ip_proto": 17, "udp_dst": 53},
                       "direction": "host -> DNS server (gateway): caught at priority 50, beats every AI rule"},
    "dns_reply":      {"match": {"eth_type": 2048, "ip_proto": 17, "udp_src": 53},
                       "direction": "DNS server (gateway) -> host: forwarded by learned rules (priority 1), so an AI drop rule could catch it"},
    "dhcp_intercept": {"priority": 50, "cookie": 64, "match": {"eth_type": 2048, "ip_proto": 17, "udp_src": 68, "udp_dst": 67},
                       "direction": "host -> DHCP server (router): caught at priority 50"},
    "dhcp_reply":     {"match": {"eth_type": 2048, "ip_proto": 17, "udp_src": 67, "udp_dst": 68},
                       "direction": "router -> host (offer/ack): forwarded by learned rules"},
    "management":     {"subnet_from": "management.subnet", "tcp_ports": [6633, 8080, 22],
                       "direction": "out-of-band: OpenFlow (6633), REST (8080) and SSH (22) to/from the management subnet; no data-plane rule may touch these addresses or ports"},
    "table_miss":     {"priority": 0,  "cookie": 0,  "match": {}}
  },

  "flow_cookies": {
    "_about": "Who owns a flow rule, by its OpenFlow cookie (decimal). A rule with any other cookie was not installed by our apps: an unauthorized flow (Part B). 176/177 = 0xB0/0xB1 are reserved for the AI layer.",
    "0":   "table_miss",
    "16":  "learned",
    "48":  "dns_intercept",
    "64":  "dhcp_intercept",
    "80":  "tcp_sensor",
    "81":  "tcp_sensor_connection",
    "176": "ai_intent",
    "177": "ai_response"
  },

  "ai_policy": {
    "_about": "What the AI layer (B2 intents, B3 responses) may install or delete. Enforced in code by part_b/nsot_validator.py, never only in a prompt.",
    "priority_min": 20,
    "priority_max": 40,
    "cookies": {"intent": 176, "response": 177},
    "may_delete_cookies": [176, 177, 16],
    "may_delete_note": "its own rules, and learned rules (16, re-learned automatically after a link failure). Rules with any other cookie listed above are never deleted; a rule with an unknown cookie (unauthorized) may be deleted by B3.",
    "allowed_match_fields": ["in_port", "eth_src", "eth_dst", "eth_type", "ip_proto", "ipv4_src", "ipv4_dst",
                             "tcp_src", "tcp_dst", "udp_src", "udp_dst"],
    "allowed_actions": ["drop", "meter"],
    "response_hard_timeout": 120,
    "intent_hard_timeout_max": 3600,
    "enforce_at": "the edge switch of the source host (the port it plugs into)"
  },

  "vlans": {
    "10": {"name": "users",   "subnet": "10.10.10.0/24", "gateway": "10.10.10.1"},
    "20": {"name": "servers", "subnet": "10.10.20.0/24", "gateway": "10.10.20.1"}
  },

  "switches": {
    "cisco1": {
      "dpid": 1,
      "vendor": "cisco",
      "vlan_mode": "controller",
      "mgmt": {"ip": "10.224.76.126", "user": "mininet", "ssh_key": "~/.ssh/lab9_nsot",
               "driver": "ovs", "bridge": "cisco1"},
      "openflow": {"version": "1.3", "transport": "tcp"},
      "ports": {
        "1": {"to": "r1",        "mode": "trunk", "vlans": [10, 20]},
        "2": {"to": "arista1:1", "mode": "trunk", "vlans": [10, 20]},
        "3": {"to": "arista2:1", "mode": "trunk", "vlans": [10, 20]},
        "4": {"to": "hp1:1",     "mode": "trunk", "vlans": [10, 20]}
      }
    },
    "arista1": {
      "dpid": 11,
      "vendor": "arista",
      "vlan_mode": "controller",
      "mgmt": {"ip": "10.224.76.126", "user": "mininet", "ssh_key": "~/.ssh/lab9_nsot",
               "driver": "ovs", "bridge": "arista1"},
      "openflow": {"version": "1.3", "transport": "tcp"},
      "ports": {
        "1": {"to": "cisco1:2", "mode": "trunk",  "vlans": [10, 20]},
        "2": {"to": "pc1",      "mode": "access", "vlan": 10},
        "3": {"to": "ovs1:1",   "mode": "trunk",  "vlans": [10, 20]},
        "4": {"to": "arista2:4", "mode": "trunk", "vlans": [10, 20], "standby": true}
      }
    },
    "arista2": {
      "dpid": 12,
      "vendor": "arista",
      "vlan_mode": "controller",
      "mgmt": {"ip": "10.224.76.126", "user": "mininet", "ssh_key": "~/.ssh/lab9_nsot",
               "driver": "ovs", "bridge": "arista2"},
      "openflow": {"version": "1.3", "transport": "tcp"},
      "ports": {
        "1": {"to": "cisco1:3", "mode": "trunk",  "vlans": [10, 20]},
        "2": {"to": "pc2",      "mode": "access", "vlan": 10},
        "3": {"to": "ovs2:1",   "mode": "trunk",  "vlans": [10, 20]},
        "4": {"to": "arista1:4", "mode": "trunk", "vlans": [10, 20], "standby": true}
      }
    },
    "hp1": {
      "dpid": 21,
      "vendor": "hp",
      "vlan_mode": "controller",
      "mgmt": {"ip": "10.224.76.126", "user": "mininet", "ssh_key": "~/.ssh/lab9_nsot",
               "driver": "ovs", "bridge": "hp1"},
      "openflow": {"version": "1.3", "transport": "tcp"},
      "ports": {
        "1": {"to": "cisco1:4", "mode": "trunk",  "vlans": [10, 20]},
        "2": {"to": "srv1",     "mode": "access", "vlan": 20}
      }
    },
    "ovs1": {
      "dpid": 31,
      "vendor": "ovs",
      "vlan_mode": "controller",
      "mgmt": {"ip": "10.224.76.126", "user": "mininet", "ssh_key": "~/.ssh/lab9_nsot",
               "driver": "ovs", "bridge": "ovs1"},
      "openflow": {"version": "1.3", "transport": "tcp"},
      "ports": {
        "1": {"to": "arista1:3", "mode": "trunk",  "vlans": [10, 20]},
        "2": {"to": "vm1",      "mode": "access", "vlan": 20}
      }
    },
    "ovs2": {
      "dpid": 32,
