      "mgmt": {"ip": "10.224.76.126", "user": "mininet", "ssh_key": "~/.ssh/lab9_nsot",
               "driver": "ovs", "bridge": "ovs2"},
      "openflow": {"version": "1.3", "transport": "tcp"},
      "ports": {
        "1": {"to": "arista2:3", "mode": "trunk",  "vlans": [10, 20]},
        "2": {"to": "vm2",      "mode": "access", "vlan": 20}
      }
    }
  },

  "routers": {
    "r1": {
      "vendor": "cisco",
      "lan": {"to": "cisco1:1", "mac": "00:00:00:00:01:01",
              "ios_interface": "GigabitEthernet0/1"},
      "wan": {"ip": "203.0.113.1/30", "next_hop": "203.0.113.2",
              "ios_interface": "GigabitEthernet0/0"},
      "nat": true,
      "dhcp": {
        "10": {"start": "10.10.10.100", "end": "10.10.10.199"},
        "20": {"start": "10.10.20.100", "end": "10.10.20.199"}
      }
    }
  },

  "external": {
    "inet": {"ip": "203.0.113.2/30", "mac": "00:00:00:00:99:02", "to": "r1:wan"}
  },

  "hosts": {
    "pc1":  {"ip": "10.10.10.11/24", "mac": "00:00:00:00:10:11"},
    "pc2":  {"ip": "10.10.10.12/24", "mac": "00:00:00:00:10:12"},
    "srv1": {"ip": "10.10.20.21/24", "mac": "00:00:00:00:20:21"},
